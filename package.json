{
  "name": "branchpilot",
  "displayName": "BranchPilot",
  "description": "%branchpilot.description%",
  "version": "0.1.0",
  "publisher": "luisrodriguez-rgb",
  "icon": "media/icon.png",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/luisrodriguez-rgb/BranchPilot.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "branch",
    "ai",
    "agents",
    "worktree"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "branchpilot": "./dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchpilot",
          "title": "BranchPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "branchpilot": [
        {
          "type": "webview",
          "id": "branchpilot.panel",
          "name": "%branchpilot.view.branches%"
        }
      ],
      "scm": [
        {
          "type": "webview",
          "id": "branchpilot.scmPanel",
          "name": "BranchPilot"
        }
      ]
    },
    "commands": [
      {
        "command": "branchpilot.refresh",
        "title": "%branchpilot.command.refresh%"
      },
      {
        "command": "branchpilot.focusPanel",
        "title": "%branchpilot.command.focusPanel%"
      },
      {
        "command": "branchpilot.checkout",
        "title": "%branchpilot.command.checkout%"
      },
      {
        "command": "branchpilot.createBranch",
        "title": "%branchpilot.command.createBranch%"
      },
      {
        "command": "branchpilot.renameBranch",
        "title": "%branchpilot.command.renameBranch%"
      },
      {
        "command": "branchpilot.deleteBranch",
        "title": "%branchpilot.command.deleteBranch%"
      },
      {
        "command": "branchpilot.undoLastBranchAction",
        "title": "%branchpilot.command.undoLastBranchAction%"
      },
      {
        "command": "branchpilot.createTaskBranch",
        "title": "%branchpilot.command.createTaskBranch%"
      },
      {
        "command": "branchpilot.moveDirtyToTaskBranch",
        "title": "%branchpilot.command.moveDirtyToTaskBranch%"
      },
      {
        "command": "branchpilot.verifyBranchForTask",
        "title": "%branchpilot.command.verifyBranchForTask%"
      },
      {
        "command": "branchpilot.setupAgentRules",
        "title": "%branchpilot.command.setupAgentRules%"
      },
      {
        "command": "branchpilot.createWorktree",
        "title": "%branchpilot.command.createWorktree%"
      },
      {
        "command": "branchpilot.openWorktree",
        "title": "%branchpilot.command.openWorktree%"
      },
      {
        "command": "branchpilot.removeWorktree",
        "title": "%branchpilot.command.removeWorktree%"
      },
      {
        "command": "branchpilot.diagnoseEnvironment",
        "title": "%branchpilot.command.diagnoseEnvironment%"
      },
      {
        "command": "branchpilot.switchRepository",
        "title": "%branchpilot.command.switchRepository%"
      },
      {
        "command": "branchpilot.openRepositoryInWindow",
        "title": "%branchpilot.command.openRepositoryInWindow%"
      }
    ],
    "configuration": {
      "title": "BranchPilot",
      "properties": {
        "branchpilot.protection.mode": {
          "type": "string",
          "enum": [
            "all",
            "list",
            "off"
          ],
          "enumDescriptions": [
            "%branchpilot.config.protection.mode.all%",
            "%branchpilot.config.protection.mode.list%",
            "%branchpilot.config.protection.mode.off%"
          ],
          "default": "all",
          "description": "%branchpilot.config.protection.mode%"
        },
        "branchpilot.protection.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "develop"
          ],
          "description": "%branchpilot.config.protection.protectedBranches%"
        },
        "branchpilot.staleDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "description": "%branchpilot.config.staleDays%"
        },
        "branchpilot.scanPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%branchpilot.config.scanPaths%"
        },
        "branchpilot.worktree.copyIgnoredFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env",
            ".env.local",
            ".env.development",
            ".env.development.local",
            ".env.test"
          ],
          "description": "%branchpilot.config.worktree.copyIgnoredFiles%"
        },
        "branchpilot.worktree.linkNodeModules": {
          "type": "boolean",
          "default": true,
          "description": "%branchpilot.config.worktree.linkNodeModules%"
        },
        "branchpilot.autoGuard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%branchpilot.config.autoGuard.enabled%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
